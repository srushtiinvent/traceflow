# Exact public website origin, with no trailing slash.
TRACEFLOW_ALLOWED_ORIGINS=https://your-site.example
# Absolute directory on the runner VM, shared with the Docker daemon.
TRACEFLOW_SOURCE_DIR=/var/tmp/traceflow-src
# Rootful Docker default. For rootless Docker, set this to its socket path.
DOCKER_SOCKET=/var/run/docker.sock
